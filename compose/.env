TPOST_DOCKER_REGISTRY=tolerantsoftware
TPOST_VERSION=12.2

NGINX_VERSION=1.30.6
NGINX_PORT=13133
NGINX_HTTPS_PORT=13163

TOLERANT_REALM=tolerant
